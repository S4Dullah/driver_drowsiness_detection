*.pyc
*.pyo
*.pyd

# Log dosyaları
*.log
camera_server.log

# Ortam ve IDE dosyaları
.env
.venv/
venv/
.idea/
.vscode/

# Conda ortamı (Pi'da yeniden kurulur, burada tutulmasın)
envs/

# OS dosyaları
.DS_Store
Thumbs.db

# Claude ayar dosyaları (isteğe bağlı — paylaşmak istemiyorsan)
.claude/
